{
  "name": "vangrex-playwright",
  "version": "0.1.0",
  "private": true,
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"tsc -p electron/tsconfig.json --watch\" \"wait-on http://127.0.0.1:5173 dist-electron/electron/main.js && electron dist-electron/electron/main.js\"",
    "build:web": "vite build",
    "build:electron": "tsc -p electron/tsconfig.json",
    "build": "bun run build:web && bun run build:electron",
    "start": "electron dist-electron/electron/main.js"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.90",
    "ai": "^7.0.130",
    "dotenv": "^18.0.6",
    "electron": "^44.6.0",
    "playwright": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "wait-on": "^9.5.1"
  }
}
